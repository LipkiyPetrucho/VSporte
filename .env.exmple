# Copy this file to .env and replace placeholder values as needed.
# Для продакшена: DJANGO_ENV=prod, реальный SECRET_KEY, SMS_BACKEND=twilio,
# рабочие SMTP/OAuth/Yandex, YANDEX_MAPS_REFERER=https://jteam.ru/
# HTTPS: docker compose -f docker-compose.prod.yml; сертификаты в ./certs/
#   fullchain.pem + privkey.pem (Let's Encrypt или свой LB)

# ------------------------------------------------------------------
# Django core
# ------------------------------------------------------------------
# Допустимые значения: local | prod (не "production" — иначе приложение не стартует)
DJANGO_ENV=local
SECRET_KEY=replace_me_with_random_64_chars
# DEBUG и ALLOWED_HOSTS задаются в settings/local.py и settings/prod.py — не через .env

# ------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------
# Docker Compose подставляет DB_* / POSTGRES_DB из этих переменных.
# Не используйте ${VAR} в этом файле — Docker env_file их не раскрывает.
POSTGRES_DB_NAME=jteam_db
POSTGRES_DB_USER=jteam_user
POSTGRES_DB_PASSWORD=supersecret
POSTGRES_DB_HOST=database
POSTGRES_DB_PORT=5432

# Redis / Celery (в Docker — имя сервиса redis; локально без Docker — 127.0.0.1)
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0

# ------------------------------------------------------------------
# PGAdmin (optional)
# ------------------------------------------------------------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin_password

# ------------------------------------------------------------------
# Stripe payments
# ------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_API_VERSION=2022-08-01
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ------------------------------------------------------------------
# Email (Yandex SMTP) – adjust for your provider if different
# ------------------------------------------------------------------
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=email_password
# Письма об HTTP 500 (AdminEmailHandler). Прод: реальные адреса.
ADMINS=[["Admin","you@example.com"]]

# ------------------------------------------------------------------
# Error reporting (prod)
# ------------------------------------------------------------------
# AdminEmailHandler работает через SMTP + ADMINS выше.
# Sentry опционален: если DSN пустой — SDK не инициализируется.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ------------------------------------------------------------------
# Postgres backups (docker-compose.prod.yml, сервис backup)
# ------------------------------------------------------------------
# Дампы: ./backups/jteam_YYYYMMDD_HHMMSS.dump (custom format, pg_restore)
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# ------------------------------------------------------------------
# Social authentication
# ------------------------------------------------------------------
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=google_client_id
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=google_client_secret
# Telegram Login Widget (@BotFather → /newbot, затем /setdomain)
SOCIAL_AUTH_TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_BOT_USERNAME=YourBotUsername

# ------------------------------------------------------------------
# SMS (phone verification)
# ------------------------------------------------------------------
# local: console (коды в лог).
# prod: в settings/prod.py по умолчанию SMS_BACKEND=twilio — задайте валидные TWILIO_*.
# Пакет: twilio (см. requirements.txt).
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567
PHONE_CODE_TTL_MINUTES=10
PHONE_CODE_MAX_ATTEMPTS=5
PHONE_CODE_RESEND_COOLDOWN=60

# ------------------------------------------------------------------
# Marketplace (venue rental, cart, payments)
# ------------------------------------------------------------------
MARKETPLACE_ENABLED=false

# ------------------------------------------------------------------
# Yandex Maps API
# ------------------------------------------------------------------
# Локальная разработка: HTTP Referer во всех ключах = localhost (без порта).
# Открывайте сайт через http://localhost:8000/, не 127.0.0.1.
#
# Перед продакшеном: добавить реальный домен в HTTP Referer
# во ВСЕХ трёх ключах в кабинете Yandex (developer.tech.yandex.ru):
#   1. JavaScript API          → YANDEX_MAPS_API_KEY
#   2. API Геосаджеста         → YANDEX_MAPS_SUGGEST_API_KEY
#   3. API Геокодера           → YANDEX_GEOCODER_API_KEY
# Пример: jteam.ru  (поддомены добавляются автоматически)
# Также обновите YANDEX_MAPS_REFERER=https://jteam.ru/
# Поле IP-адресов для серверных ключей оставьте пустым или укажите IP сервера.
# ------------------------------------------------------------------
YANDEX_MAPS_API_KEY=yandex_maps_api_key
YANDEX_MAPS_API_KEY_STATIC=yandex_maps_static_key
# Ключ Geosuggest API для подсказок адресов (если не задан, используется YANDEX_MAPS_API_KEY)
YANDEX_MAPS_SUGGEST_API_KEY=yandex_maps_suggest_api_key
# Referer для серверных запросов к HTTP Geocoder (должен совпадать с ограничениями ключа)
YANDEX_MAPS_REFERER=http://localhost:8000/
# Отдельный ключ HTTP Geocoder, если отличается от JavaScript API (необязательно)
YANDEX_GEOCODER_API_KEY=yandex_geocoder_api_key
